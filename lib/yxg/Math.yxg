// ============================================================
// yxg.Math 标准库 - 数学函数与常量
// 用法：import yxg.Math;
// 提供数学常量、基本算术、三角函数、随机数生成等功能。
// 三角函数使用泰勒级数近似，随机数基于自定义的四状态发生器。
//
// yxg.Math Standard Library - Mathematical functions and constants
// Usage: import yxg.Math;
// Provides mathematical constants, basic arithmetic, trigonometric functions,
// random number generation, etc. Trigonometric functions are based on Taylor
// series; the RNG uses a custom 4-state generator.
// ============================================================

pub class Math {
    // ==================== 常量 / Constants ====================
    /// 圆周率 π / Archimedes' constant π
    pub float PI  = 3.141592653589793;
    /// 自然对数的底数 e / Euler's number e
    pub float E   = 2.718281828459045;
    /// 圆的周长与半径之比 τ = 2π / Circle constant τ = 2π
    pub float TAU = 6.283185307179586;

    // ==================== 内部状态（用于伪随机数生成器）
    //                Internal state for the pseudo‑random number generator ====================
    // 四个内部状态变量，构成128位状态空间。
    // 通过 srand() 使用 SplitMix32 算法初始化，之后由 _next() 更新。
    //
    // Four internal state variables forming a 128‑bit state space.
    // Initialised by srand() using the SplitMix32 algorithm and updated by _next().
    pri uint _s0 = 12345;
    pri uint _s1 = 67890;
    pri uint _s2 = 0x9E3779B9;
    pri uint _s3 = 0xC2B2AE35;

    // ==================== 绝对值 / Absolute value ====================
    /// 计算整数 x 的绝对值
    /// @param x 输入整数 / input integer
    /// @return |x|
    pub int abs(int x) {
        if x < 0 {
            return -x;
        }
        return x;
    }

    /// 计算浮点数 x 的绝对值
    /// @param x 输入浮点数 / input float
    /// @return |x|
    pub float fabs(float x) {
        if x < 0.0 {
            return -x;
        }
        return x;
    }

    // ==================== 最值函数 / Min & Max ====================
    /// 返回两个整数中的较小值
    /// @param a,b 输入整数 / input integers
    /// @return min(a,b)
    pub int min(int a, int b) {
        if a < b {
            return a;
        }
        return b;
    }

    /// 返回两个整数中的较大值
    /// @param a,b 输入整数 / input integers
    /// @return max(a,b)
    pub int max(int a, int b) {
        if a > b {
            return a;
        }
        return b;
    }

    /// 返回两个浮点数中的较小值
    /// @param a,b 输入浮点数 / input floats
    /// @return min(a,b)
    pub float fmin(float a, float b) {
        if a < b {
            return a;
        }
        return b;
    }

    /// 返回两个浮点数中的较大值
    /// @param a,b 输入浮点数 / input floats
    /// @return max(a,b)
    pub float fmax(float a, float b) {
        if a > b {
            return a;
        }
        return b;
    }

    /// 将 value 限制在闭区间 [lo, hi] 内
    /// @param value 待限制的值 / value to clamp
    /// @param lo    下界 / lower bound
    /// @param hi    上界 / upper bound
    /// @return clamp(value, lo, hi)
    pub int clamp(int value, int lo, int hi) {
        if value < lo {
            return lo;
        }
        if value > hi {
            return hi;
        }
        return value;
    }

    // ==================== 整数幂 / Integer power ====================
    /// 计算 base 的 exp 次幂（整数指数）
    /// 若 exp < 0 返回 0；exp == 0 返回 1。
    /// @param base 底数 / base
    /// @param exp  指数 / exponent
    /// @return base^exp (整数 / integer)
    pub int pow(int base, int exp) {
        if exp < 0 {
            return 0;
        }
        if exp == 0 {
            return 1;
        }
        int result = 1;
        for int i = 0; i < exp; i++ {
            result = result * base;
        }
        return result;
    }

    // ==================== 平方根 / Square root (Newton's method) ====================
    /// 使用牛顿迭代法计算 x 的平方根
    /// x <= 0 时返回 0.0。固定 20 次迭代。
    /// @param x 输入值 / input value
    /// @return sqrt(x)
    pub float sqrt(float x) {
        if x <= 0.0 {
            return 0.0;
        }
        float guess = x;
        for int i = 0; i < 20; i++ {
            guess = (guess + x / guess) / 2.0;
        }
        return guess;
    }

    // ==================== 三角函数 / Trigonometric functions (Taylor series) ====================
    /// 计算 sin(x)，使用泰勒级数展开到 11 阶，并先将角度规约到 [-PI, PI]。
    /// @param x 弧度 / radians
    /// @return sin(x)
    pub float sin(float x) {
        // 将 x 归约到 [-PI, PI] / reduce x to [-PI, PI]
        while x > PI {
            x = x - TAU;
        }
        while x < -PI {
            x = x + TAU;
        }

        float x2 = x * x;
        float term = x;
        float result = x;
        // x^3/3!
        term = term * x2 / 6.0;
        result = result - term;
        // x^5/5!
        term = term * x2 / 20.0;
        result = result + term;
        // x^7/7!
        term = term * x2 / 42.0;
        result = result - term;
        // x^9/9!
        term = term * x2 / 72.0;
        result = result + term;
        // x^11/11!
        term = term * x2 / 110.0;
        result = result - term;

        return result;
    }

    /// 计算 cos(x)，利用恒等式 cos(x) = sin(x + π/2)
    /// @param x 弧度 / radians
    /// @return cos(x)
    pub float cos(float x) {
        return sin(x + PI / 2.0);
    }

    /// 计算 tan(x) = sin(x) / cos(x)
    /// @param x 弧度 / radians
    /// @return tan(x)
    pub float tan(float x) {
        float s = sin(x);
        float c = cos(x);
        return s / c;
    }

    // ==================== 阶乘 / Factorial ====================
    /// 计算 n 的阶乘 n!，n <= 1 时返回 1。
    /// @param n 非负整数 / non‑negative integer
    /// @return n!
    pub int factorial(int n) {
        if n <= 1 {
            return 1;
        }
        int result = 1;
        for int i = 2; i <= n; i++ {
            result = result * i;
        }
        return result;
    }

    // ==================== 最大公约数 / 最小公倍数 / GCD & LCM ====================
    /// 使用欧几里得算法计算 a 和 b 的最大公约数（结果非负）。
    /// @param a,b 输入整数（符号会被忽略） / input integers (signs are ignored)
    /// @return gcd(|a|, |b|)
    pub int gcd(int a, int b) {
        a = abs(a);
        b = abs(b);
        while b != 0 {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }

    /// 计算 a 和 b 的最小公倍数。若任一为 0 则返回 0。
    /// @param a,b 输入整数 / input integers
    /// @return lcm(a,b)
    pub int lcm(int a, int b) {
        if a == 0 || b == 0 {
            return 0;
        }
        int g = gcd(a, b);
        return abs(a) / g * abs(b);
    }

    // ==================== 素数判断 / Primality test ====================
    /// 判断 n 是否为素数，使用 6k±1 优化试除法。
    /// @param n 待测试整数 / integer to test
    /// @return true 如果 n 是素数 / true if n is prime
    pub bool isPrime(int n) {
        if n <= 1 {
            return false;
        }
        if n <= 3 {
            return true;
        }
        if n % 2 == 0 || n % 3 == 0 {
            return false;
        }
        int i = 5;
        while i * i <= n {
            if n % i == 0 || n % (i + 2) == 0 {
                return false;
            }
            i += 6;
        }
        return true;
    }

    // ==================== 伪随机数 / Pseudo‑random numbers ====================
    /// 内部核心：更新状态并返回一个 32 位随机数
    /// Internal core: advances the state and returns a 32‑bit random number
    pri uint _next() {
        uint result = ((_s0 + _s3) << 7 | (_s0 + _s3) >> 25) + _s0;
        uint t = _s1 << 9;
        _s2 ^= _s0;
        _s3 ^= _s1;
        _s1 ^= _s2;
        _s0 ^= _s3;
        _s2 ^= t;
        _s3 = (_s3 << 11 | _s3 >> 21);
        return result;
    }

    /// SplitMix32 算法，用于将单个种子扩展为更高质量的随机状态。
    /// @param z 输入种子 / input seed
    /// @return 哈希后的 32 位值 / hashed 32‑bit value
    pri uint _splitmix32(uint z) {
        z = z + 0x9E3779B9;
        z = (z ^ (z >> 16)) * 0x85EBCA6B;
        z = (z ^ (z >> 13)) * 0xC2B2AE35;
        return z ^ (z >> 16);
    }

    /// 用整数 seed 初始化随机数生成器的四个状态变量。
    /// @param seed 种子 / initial seed
    pub void srand(int seed) {
        uint z = seed;
        _s0 = _splitmix32(z);
        z = z + 0x9E3779B9;
        _s1 = _splitmix32(z);
        z = z + 0x9E3779B9;
        _s2 = _splitmix32(z);
        z = z + 0x9E3779B9;
        _s3 = _splitmix32(z);
    }

    /// 返回一个非负伪随机整数，范围 [0, 2^31-1]。
    /// @return 随机整数 / random integer in [0, 2^31-1]
    pub int random() {
        return _next() & 0x7FFFFFFF;
    }

    /// 返回闭区间 [lo, hi] 内的一个伪随机整数。
    /// 若 lo >= hi 直接返回 lo。
    /// @param lo 下界 / lower bound (inclusive)
    /// @param hi 上界 / upper bound (inclusive)
    /// @return 随机整数 / random integer in [lo, hi]
    pub int randint(int lo, int hi) {
        if lo >= hi { return lo; }
        uint range = hi - lo + 1;
        uint r = _next();
        return lo + (r % range);
    }
    
    /// 返回 [0.0, 1.0) 范围内的伪随机浮点数。
    /// @return 随机浮点数 / random float in [0, 1)
    pub float randfloat() {
        return _next() / 4294967296.0;   // 除以 2^32 / divide by 2^32
    }

    // ==================== 符号函数 / Sign function ====================
    /// 返回 x 的符号：正数返回 1，负数返回 -1，零返回 0。
    /// @param x 输入整数 / input integer
    /// @return sign(x) ∈ {-1, 0, 1}
    pub int sign(int x) {
        if x > 0 {
            return 1;
        }
        if x < 0 {
            return -1;
        }
        return 0;
    }
}